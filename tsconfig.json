{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "components/skull-orb/demo/src",
    "components/skull-orb/package/src",
    "components/skull-orb/package/tests",
    "components/sun-creature/demo/src",
    "components/sun-creature/package/src"
  ]
}
